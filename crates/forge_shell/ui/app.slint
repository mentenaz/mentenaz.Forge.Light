import { LineEdit, ListView } from "std-widgets.slint";
import { Theme, PanelInfo, TabInfo, Notice, FileRow, LspInfo, EditorView, LineView, SpanView, MatchView, DiagView, ProblemRow, OutlineRow, ExtListRow, SearchRow } from "theme.slint";
import { FindInput } from "codeview.slint";
import { Ico, FlatButton, VSep, HSep, MenuRow, PopupSurface, WinButton } from "widgets.slint";
import { Branding } from "branding.slint";
import { Pane } from "pane.slint";

export { Theme, ExtListRow, PanelInfo, TabInfo, Notice, FileRow, LspInfo, EditorView, LineView, SpanView, MatchView, DiagView, ProblemRow, SearchRow }

// ---- dock content -------------------------------------------------------

component ExplorerView inherits Rectangle {
    in property <[FileRow]> files;
    callback row-clicked(int);
    ListView {
        for row[i] in root.files: Rectangle {
            height: 24px;
            background: ta.has-hover ? Theme.hover : transparent;
            ta := TouchArea { clicked => { root.row-clicked(i); } }
            HorizontalLayout {
                padding-left: 8px + row.depth * 14px;
                padding-right: 8px;
                spacing: 5px;
                Rectangle {
                    width: 12px;
                    if row.is-dir: Ico {
                        name: row.expanded ? "chevron-down" : "chevron-right";
                        size: 12px; tint: Theme.muted-fg; y: (parent.height - self.height) / 2;
                    }
                }
                Ico {
                    name: row.is-dir ? (row.expanded ? "folder-open" : "folder") : "file";
                    tint: row.is-dir ? Theme.link : Theme.muted-fg;
                    y: (parent.height - self.height) / 2;
                }
                Text { text: row.name; font-size: 12px; color: Theme.foreground; vertical-alignment: center; overflow: elide; }
            }
        }
    }
}

component ProblemsView inherits Rectangle {
    in property <[ProblemRow]> rows;
    in property <string> empty: "No problems detected.";
    callback clicked(int);
    if root.rows.length == 0: Text {
        text: root.empty;
        font-size: 12px; color: Theme.muted-fg; horizontal-alignment: center; vertical-alignment: center;
    }
    ListView {
        for row in root.rows: Rectangle {
            height: row.header ? 26px : 22px;
            background: !row.header && ta.has-hover ? Theme.hover : transparent;
            ta := TouchArea {
                enabled: !row.header;
                clicked => { root.clicked(row.item); }
            }
            HorizontalLayout {
                padding-left: row.header ? 10px : 24px;
                padding-right: 10px;
                spacing: 6px;
                if row.header: Ico { name: "file"; tint: Theme.muted-fg; y: (parent.height - self.height) / 2; }
                if !row.header && row.severity > 0: Ico {
                    name: row.severity == 1 ? "error" : row.severity == 2 ? "warn" : "info";
                    tint: Theme.severity(row.severity);
                    y: (parent.height - self.height) / 2;
                }
                Text {
                    text: row.label; font-size: 12px; vertical-alignment: center; overflow: elide;
                    font-weight: row.header ? 600 : 400; color: Theme.foreground; horizontal-stretch: 1;
                }
                Text { text: row.sub; font-size: 11px; color: Theme.muted-fg; vertical-alignment: center; }
            }
        }
    }
}

component OutlineView inherits Rectangle {
    in property <[OutlineRow]> rows;
    callback clicked(int);
    if root.rows.length == 0: Text {
        text: "No outline. Open a file with a running language server.";
        font-size: 12px; color: Theme.muted-fg; horizontal-alignment: center; vertical-alignment: center; wrap: word-wrap;
    }
    ListView {
        for row in root.rows: Rectangle {
            height: 22px;
            background: ta.has-hover ? Theme.hover : transparent;
            ta := TouchArea { clicked => { root.clicked(row.item); } }
            HorizontalLayout {
                padding-left: 10px + row.depth * 14px;
                padding-right: 10px;
                spacing: 6px;
                Text { text: row.label; font-size: 12px; vertical-alignment: center; overflow: elide; color: Theme.foreground; horizontal-stretch: 1; }
                Text { text: row.kind; font-size: 11px; color: Theme.muted-fg; vertical-alignment: center; }
            }
        }
    }
}

component ExtensionsView inherits Rectangle {
    in property <bool> shown;
    in property <[ExtListRow]> rows;
    in property <string> status;
    in-out property <string> query;
    in-out property <int> kind: 0;
    callback refresh();
    callback search(string, int);
    callback install(string);
    callback pick-theme(int);
    init => { if root.shown { root.refresh(); } }
    changed shown => { if root.shown { root.refresh(); } }

    VerticalLayout {
        padding: 8px;
        spacing: 6px;
        HorizontalLayout {
            spacing: 4px;
            FindInput {
                placeholder: "Search extensions";
                text <=> root.query;
                horizontal-stretch: 1;
                accepted(shift) => { root.search(root.query, root.kind); }
            }
            Rectangle {
                width: 70px;
                height: 24px;
                border-radius: 4px;
                background: kind-ta.has-hover ? Theme.hover : transparent;
                kind-ta := TouchArea { clicked => { root.kind = Math.mod(root.kind + 1, 3); root.search(root.query, root.kind); } }
                Text { text: root.kind == 0 ? "Themes" : root.kind == 1 ? "Languages" : "All"; font-size: 11px; color: Theme.foreground; horizontal-alignment: center; vertical-alignment: center; }
            }
        }
        Text { text: root.status; font-size: 11px; color: Theme.muted-fg; overflow: elide; }
        ListView {
            vertical-stretch: 1;
            for row in root.rows: Rectangle {
                height: row.kind == 0 ? 26px : row.kind == 1 ? 22px : 40px;
                background: row.kind != 0 && ta.has-hover ? Theme.hover : transparent;
                clip: true;
                ta := TouchArea {
                    enabled: row.kind == 1 || (row.kind == 2 && (row.state == 0 || row.state == 3));
                    clicked => {
                        if row.kind == 1 { root.pick-theme(row.item); } else { root.install(row.id); }
                    }
                }
                if row.kind == 0: Text {
                    x: 8px; text: row.label; font-size: 12px; font-weight: 600; color: Theme.foreground; vertical-alignment: center;
                }
                if row.kind == 1: HorizontalLayout {
                    padding-left: 18px;
                    padding-right: 8px;
                    spacing: 6px;
                    Text { text: row.active ? "● " + row.label : row.label; font-size: 12px; color: Theme.foreground; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                    Text { text: row.sub; font-size: 11px; color: Theme.muted-fg; vertical-alignment: center; }
                }
                if row.kind == 2: HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 8px;
                    spacing: 8px;
                    VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 1;
                        Text { text: row.label; font-size: 12px; color: Theme.foreground; overflow: elide; }
                        Text { text: row.sub; font-size: 11px; color: Theme.muted-fg; overflow: elide; }
                    }
                    Text {
                        text: row.state == 1 ? "Installing…" : row.state == 2 ? "Installed" : row.state == 3 ? "Update" : "Install";
                        font-size: 11px;
                        color: row.state == 0 || row.state == 3 ? Theme.primary : Theme.muted-fg;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}

component SearchView inherits Rectangle {
    in property <[SearchRow]> rows;
    in property <string> status;
    in-out property <string> query;
    in-out property <bool> match-case;
    in property <int> focus-tick;
    callback edited();
    callback accepted();
    callback clicked(int);
    changed focus-tick => { input.focus-field(); input.select-field(); }

    VerticalLayout {
        padding: 8px;
        spacing: 6px;
        HorizontalLayout {
            spacing: 4px;
            input := FindInput {
                placeholder: "Search in project";
                text <=> root.query;
                horizontal-stretch: 1;
                edited => { root.edited(); }
                accepted(shift) => { root.accepted(); }
            }
            Rectangle {
                width: 26px;
                height: 24px;
                border-radius: 4px;
                background: root.match-case ? Theme.accent : case-ta.has-hover ? Theme.hover : transparent;
                case-ta := TouchArea { clicked => { root.match-case = !root.match-case; root.edited(); } }
                Text { text: "Aa"; font-size: 11px; color: root.match-case ? Theme.foreground : Theme.muted-fg; horizontal-alignment: center; vertical-alignment: center; }
            }
        }
        Text { text: root.status; font-size: 11px; color: Theme.muted-fg; overflow: elide; }
        ListView {
            vertical-stretch: 1;
            for row in root.rows: Rectangle {
                height: row.header ? 26px : 22px;
                background: !row.header && ta.has-hover ? Theme.hover : transparent;
                clip: true;
                ta := TouchArea {
                    enabled: !row.header;
                    clicked => { root.clicked(row.item); }
                }
                HorizontalLayout {
                    padding-left: row.header ? 2px : 6px;
                    padding-right: 6px;
                    spacing: row.header ? 6px : 0px;
                    if row.header: Ico { name: "file"; tint: Theme.muted-fg; y: (parent.height - self.height) / 2; }
                    if row.header: Text { text: row.before; font-size: 12px; font-weight: 600; color: Theme.foreground; vertical-alignment: center; }
                    if row.header: Text { text: row.sub; font-size: 11px; color: Theme.muted-fg; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                    if !row.header: Text { text: row.sub; width: 34px; font-size: 11px; color: Theme.muted-fg; vertical-alignment: center; }
                    if !row.header && row.before != "": Text { text: row.before; font-size: 12px; color: Theme.foreground; vertical-alignment: center; }
                    if !row.header: Rectangle {
                        width: match-text.preferred-width;
                        background: Theme.primary.with-alpha(0.35);
                        border-radius: 2px;
                        match-text := Text { text: row.matched; font-size: 12px; color: Theme.foreground; vertical-alignment: center; }
                    }
                    if !row.header: Text { text: row.after; font-size: 12px; color: Theme.foreground; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                }
            }
        }
    }
}

component DockPanel inherits Rectangle {
    in property <PanelInfo> panel;
    in property <[FileRow]> files;
    in property <[ProblemRow]> problems;
    in property <[ProblemRow]> references;
    in property <[OutlineRow]> outline;
    in property <[ExtListRow]> ext-rows;
    in property <string> ext-status;
    in property <[SearchRow]> search-rows;
    in property <string> search-status;
    in-out property <string> search-query;
    in-out property <bool> search-case;
    in property <int> search-focus;
    callback search-edited();
    callback search-accepted();
    callback search-clicked(int);
    callback open-tab(string);
    callback row-clicked(int);
    callback problem-clicked(int);
    callback reference-clicked(int);
    callback outline-clicked(int);
    callback ext-refresh();
    callback ext-search(string, int);
    callback ext-install(string);
    callback theme-picked(int);
    callback hide();
    background: Theme.chrome;

    VerticalLayout {
        Rectangle {
            height: 30px;
            HorizontalLayout {
                padding-left: 10px;
                padding-right: 4px;
                spacing: 6px;
                Ico { name: root.panel.icon; tint: Theme.muted-fg; y: (parent.height - self.height) / 2; }
                Text { text: root.panel.title; font-size: 11px; font-weight: 700; color: Theme.muted-fg; vertical-alignment: center; horizontal-stretch: 1; }
                FlatButton { icon: "close"; width: 24px; pad: 6px; y: 3px; clicked => { root.hide(); } }
            }
            Rectangle { y: parent.height - 1px; height: 1px; background: Theme.border; }
        }
        if root.panel.id == "explorer": ExplorerView {
            files: root.files;
            row-clicked(i) => { root.row-clicked(i); }
        }
        if root.panel.id == "problems": ProblemsView {
            rows: root.problems;
            clicked(i) => { root.problem-clicked(i); }
        }
        if root.panel.id == "references": ProblemsView {
            rows: root.references;
            empty: "No references. Put the caret on a symbol and press Shift+F12.";
            clicked(i) => { root.reference-clicked(i); }
        }
        if root.panel.id == "outline": OutlineView {
            rows: root.outline;
            clicked(i) => { root.outline-clicked(i); }
        }
        if root.panel.id == "extensions": ExtensionsView {
            shown: root.visible;
            rows: root.ext-rows;
            status: root.ext-status;
            refresh() => { root.ext-refresh(); }
            search(q, k) => { root.ext-search(q, k); }
            install(id) => { root.ext-install(id); }
            pick-theme(i) => { root.theme-picked(i); }
        }
        if root.panel.id == "search": SearchView {
            rows: root.search-rows;
            status: root.search-status;
            query <=> root.search-query;
            match-case <=> root.search-case;
            focus-tick: root.search-focus;
            edited => { root.search-edited(); }
            accepted => { root.search-accepted(); }
            clicked(i) => { root.search-clicked(i); }
        }
        if root.panel.id != "explorer" && root.panel.id != "problems" && root.panel.id != "references" && root.panel.id != "outline" && root.panel.id != "extensions" && root.panel.id != "search": VerticalLayout {
            padding: 12px;
            spacing: 10px;
            alignment: start;
            Text { text: "The " + root.panel.title + " panel will live here."; font-size: 12px; color: Theme.muted-fg; wrap: word-wrap; }
            Rectangle {
                height: 28px;
                border-radius: 4px;
                border-width: 1px;
                border-color: Theme.border;
                background: open.has-hover ? Theme.hover : transparent;
                open := TouchArea { clicked => { root.open-tab(root.panel.id); } }
                Text { text: "Open " + root.panel.title + " tab"; font-size: 12px; color: Theme.foreground; }
            }
        }
    }
}

// ---- window ---------------------------------------------------------------

export component AppWindow inherits Window {
    title: Branding.window-title;
    no-frame: true;
    preferred-width: 1280px;
    preferred-height: 800px;
    min-width: 760px;
    min-height: 480px;
    background: Theme.background;
    default-font-size: 13px;

    in property <[PanelInfo]> panels;
    in property <[PanelInfo]> left-panels;
    in property <[PanelInfo]> right-panels;
    in property <[PanelInfo]> bottom-panels;
    in-out property <string> left-panel;
    in-out property <string> right-panel;
    in-out property <string> bottom-panel;
    in-out property <length> left-w: 260px;
    in-out property <length> right-w: 300px;
    in-out property <length> bottom-h: 240px;
    in-out property <bool> zoomed;

    in property <[TabInfo]> tabs;
    in property <int> active-tab: -1;
    in property <string> body;
    in property <[TabInfo]> split-tabs;
    in property <int> split-active: -1;
    in property <string> split-body;
    in property <int> active-group; // 0 primary, 1 split
    in property <bool> has-editor;
    in property <EditorView> editor;
    in property <bool> split-has-editor;
    in property <EditorView> split-editor;

    in property <string> project-name: "No folder open";
    in property <string> branch;
    in property <[string]> recent;
    in property <[string]> branches;
    in property <[FileRow]> files;
    in property <[Notice]> notices;
    in property <bool> format-on-save;
    in property <[ProblemRow]> problems;
    in property <[ProblemRow]> references;
    in property <[OutlineRow]> outline;
    in property <[ExtListRow]> ext-rows;
    in property <string> ext-status;
    in property <[SearchRow]> search-rows;
    in property <string> search-status;
    in-out property <string> search-query;
    in-out property <bool> search-case;
    in property <int> search-focus;
    in property <[LspInfo]> servers;
    /// Worst state across the servers (see `LspInfo.state`), -1 when there are none.
    in property <int> lsp-state: -1;
    /// Height of the menu with every row collapsed.
    in property <length> lsp-base-h: 60px;
    /// The server whose actions are showing, or -1.
    in-out property <int> lsp-open: -1;
    in property <int> errors;
    in property <int> warnings;
    in property <string> cursor-text;
    in property <string> language;
    in property <string> activity;
    in property <string> active-file;

    in property <int> unread-count;

    callback toggle-panel(string);
    callback toggle-dock(int);
    callback move-panel(string, int);
    callback open-panel-tab(string);
    callback file-clicked(int);
    callback tab-activate(int, int);
    callback tab-close(int, int);
    callback tab-close-others(int, int);
    callback tab-toggle-pin(int, int);
    callback tab-split(int, int);
    callback split-active-tab();
    callback swap-panes();
    callback focus-group(int);
    callback cycle-tab(int);
    callback close-active-tab();
    callback filter-projects(string);
    callback pick-project(string);
    callback pick-branch(string);
    callback mark-notices-read();
    callback clear-notices();
    callback open-search();
    callback toggle-format-on-save();
    callback problem-clicked(int);
    callback reference-clicked(int);
    callback outline-clicked(int);
    callback ext-refresh();
    callback ext-search(string, int);
    callback ext-install(string);
    callback theme-picked(int);
    callback search-edited();
    callback search-accepted();
    callback search-clicked(int);
    /// A background search finished; raised from its thread.
    callback search-ready();
    callback quit();
    /// A language server changed state or logged; raised from its background thread.
    callback lsp-changed();
    callback ext-changed();
    /// Server id (0 for all) and "logs", "restart", "stop", "restart-all" or "stop-all".
    callback lsp-action(int, string);
    callback ed-viewport(int, int, int);
    callback ed-text(int, string);
    callback ed-command(int, string, bool);
    callback ed-pressed(int, int, int, bool);
    callback ed-dragged(int, int, int);
    callback ed-copy(int) -> string;
    callback ed-find(int, string, string, bool);
    callback ed-seed(int) -> string;
    callback ed-hover(int, int, int);
    callback ed-definition(int, int, int);
    callback ed-rename(int, string);
    callback ed-idle(int, int, int);
    callback minimize();
    callback toggle-maximize();
    callback drag-window(length, length);
    callback resize-window(length, length);

    function toggle-theme() { Theme.custom = false; Theme.dark = !Theme.dark; root.theme-picked(-1); }

    fs := FocusScope {
        key-pressed(e) => {
            if e.modifiers.control && !e.modifiers.alt && !e.modifiers.shift && e.text == "b" { root.toggle-dock(0); return accept; }
            if e.modifiers.control && e.modifiers.alt && e.text == "b" { root.toggle-dock(1); return accept; }
            if e.modifiers.control && !e.modifiers.alt && e.text == "j" { root.toggle-dock(2); return accept; }
            if e.modifiers.control && e.text == "\\" { root.split-active-tab(); return accept; }
            if e.modifiers.control && e.text == "]" { root.swap-panes(); return accept; }
            if e.modifiers.control && e.text == "w" { root.close-active-tab(); return accept; }
            if e.modifiers.control && e.modifiers.shift && (e.text == "f" || e.text == "F") { root.open-search(); return accept; }
            if e.modifiers.control && e.text == Key.Tab { root.cycle-tab(1); return accept; }
            if e.modifiers.control && e.modifiers.shift && e.text == Key.Backtab { root.cycle-tab(-1); return accept; }
            if e.modifiers.shift && e.text == Key.Escape { root.zoomed = !root.zoomed; return accept; }
            reject
        }

        VerticalLayout {
            // ---- title bar ------------------------------------------------
            Rectangle {
                height: 36px;
                background: Theme.chrome;
                Rectangle { y: parent.height - 1px; height: 1px; background: Theme.border; }
                TouchArea {
                    moved => { root.drag-window(self.mouse-x - self.pressed-x, self.mouse-y - self.pressed-y); }
                    double-clicked => { root.toggle-maximize(); }
                }
                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 0px;
                    spacing: 4px;
                    FlatButton { icon: "menu"; width: 30px; y: 6px; clicked => { app-menu.show(); } }
                    FlatButton {
                        icon: "folder";
                        label: root.project-name;
                        tint: Theme.foreground;
                        y: 6px;
                        clicked => { root.filter-projects(""); projects.show(); }
                    }
                    if root.branch != "": FlatButton {
                        icon: "branch";
                        label: root.branch;
                        y: 6px;
                        clicked => { branch-menu.show(); }
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                        Text { text: Branding.name; font-size: 12px; color: Theme.muted-fg; }
                    }
                    FlatButton {
                        icon: "panel-left"; width: 30px; y: 6px;
                        selected: root.left-panel != "" && !root.zoomed;
                        clicked => { root.toggle-dock(0); }
                    }
                    FlatButton {
                        icon: "panel-bottom"; width: 30px; y: 6px;
                        selected: root.bottom-panel != "" && !root.zoomed;
                        clicked => { root.toggle-dock(2); }
                    }
                    FlatButton {
                        icon: "panel-right"; width: 30px; y: 6px;
                        selected: root.right-panel != "" && !root.zoomed;
                        clicked => { root.toggle-dock(1); }
                    }
                    VSep { height: 16px; y: 10px; }
                    FlatButton {
                        icon: Theme.dark ? "sun" : "moon"; width: 30px; y: 6px;
                        clicked => { root.toggle-theme(); }
                    }
                    Rectangle { width: 6px; }
                    WinButton { kind: "min"; clicked => { root.minimize(); } }
                    WinButton { kind: "max"; clicked => { root.toggle-maximize(); } }
                    WinButton { kind: "close"; clicked => { root.quit(); } }
                }
            }

            // ---- main area ------------------------------------------------
            HorizontalLayout {
                vertical-stretch: 1;
                if !root.zoomed && root.left-panel != "": HorizontalLayout {
                    Rectangle {
                        width: root.left-w;
                        for p in root.panels: DockPanel {
                            visible: p.id == root.left-panel; width: parent.width; height: parent.height;
                            panel: p;
                            files: root.files;
                            problems: root.problems;
                            problem-clicked(i) => { root.problem-clicked(i); }
                            references: root.references;
                            reference-clicked(i) => { root.reference-clicked(i); }
                            outline: root.outline;
                            outline-clicked(i) => { root.outline-clicked(i); }
                            ext-rows: root.ext-rows;
                            ext-status: root.ext-status;
                            ext-refresh() => { root.ext-refresh(); }
                            ext-search(q, k) => { root.ext-search(q, k); }
                            ext-install(id) => { root.ext-install(id); }
                            theme-picked(i) => { root.theme-picked(i); }
                            search-rows: root.search-rows;
                            search-status: root.search-status;
                            search-query <=> root.search-query;
                            search-case <=> root.search-case;
                            search-focus: root.search-focus;
                            search-edited => { root.search-edited(); }
                            search-accepted => { root.search-accepted(); }
                            search-clicked(i) => { root.search-clicked(i); }
                            open-tab(id) => { root.open-panel-tab(id); }
                            row-clicked(i) => { root.file-clicked(i); }
                            hide => { root.toggle-panel(p.id); }
                        }
                    }
                    Rectangle {
                        width: 1px;
                        background: Theme.border;
                        TouchArea {
                            x: -2px; width: 5px;
                            mouse-cursor: ew-resize;
                            moved => { root.left-w = max(180px, min(640px, root.left-w + self.mouse-x - self.pressed-x)); }
                        }
                    }
                }

                VerticalLayout {
                    horizontal-stretch: 1;
                    HorizontalLayout {
                        vertical-stretch: 1;
                        Pane {
                            horizontal-stretch: 1;
                            tabs: root.tabs;
                            active: root.active-tab;
                            body: root.body;
                            pane-focused: root.active-group == 0;
                            can-split: root.split-tabs.length == 0;
                            activate(i) => { root.tab-activate(0, i); }
                            close(i) => { root.tab-close(0, i); }
                            close-others(i) => { root.tab-close-others(0, i); }
                            toggle-pin(i) => { root.tab-toggle-pin(0, i); }
                            split(i) => { root.tab-split(0, i); }
                            focus-pane => { root.focus-group(0); }
                            has-editor: root.has-editor;
                            editor: root.editor;
                            ed-viewport(a, b) => { root.ed-viewport(0, a, b); }
                            ed-text(t) => { root.ed-text(0, t); }
                            ed-command(c, sh) => { root.ed-command(0, c, sh); }
                            ed-pressed(l, c, sh) => { root.ed-pressed(0, l, c, sh); }
                            ed-dragged(l, c) => { root.ed-dragged(0, l, c); }
                            ed-copy => { root.ed-copy(0) }
                            ed-find(k, t, f) => { root.ed-find(0, k, t, f); }
                            ed-seed => { root.ed-seed(0) }
                            ed-hover(l, c) => { root.ed-hover(0, l, c); }
                            ed-definition(l, c) => { root.ed-definition(0, l, c); }
                            ed-rename(n) => { root.ed-rename(0, n); }
                            ed-idle(l, c) => { root.ed-idle(0, l, c); }
                        }
                        if root.split-tabs.length > 0: Rectangle { width: 1px; background: Theme.border; }
                        if root.split-tabs.length > 0: Pane {
                            horizontal-stretch: 1;
                            tabs: root.split-tabs;
                            active: root.split-active;
                            body: root.split-body;
                            pane-focused: root.active-group == 1;
                            can-split: false;
                            activate(i) => { root.tab-activate(1, i); }
                            close(i) => { root.tab-close(1, i); }
                            close-others(i) => { root.tab-close-others(1, i); }
                            toggle-pin(i) => { root.tab-toggle-pin(1, i); }
                            split(i) => { root.tab-split(1, i); }
                            focus-pane => { root.focus-group(1); }
                            has-editor: root.split-has-editor;
                            editor: root.split-editor;
                            ed-viewport(a, b) => { root.ed-viewport(1, a, b); }
                            ed-text(t) => { root.ed-text(1, t); }
                            ed-command(c, sh) => { root.ed-command(1, c, sh); }
                            ed-pressed(l, c, sh) => { root.ed-pressed(1, l, c, sh); }
                            ed-dragged(l, c) => { root.ed-dragged(1, l, c); }
                            ed-copy => { root.ed-copy(1) }
                            ed-find(k, t, f) => { root.ed-find(1, k, t, f); }
                            ed-seed => { root.ed-seed(1) }
                            ed-hover(l, c) => { root.ed-hover(1, l, c); }
                            ed-definition(l, c) => { root.ed-definition(1, l, c); }
                            ed-rename(n) => { root.ed-rename(1, n); }
                            ed-idle(l, c) => { root.ed-idle(1, l, c); }
                        }
                    }
                    if !root.zoomed && root.bottom-panel != "": Rectangle {
                        height: 1px;
                        background: Theme.border;
                        TouchArea {
                            y: -2px; height: 5px;
                            mouse-cursor: ns-resize;
                            moved => { root.bottom-h = max(100px, min(800px, root.bottom-h - (self.mouse-y - self.pressed-y))); }
                        }
                    }
                    if !root.zoomed && root.bottom-panel != "": Rectangle {
                        height: root.bottom-h;
                        for p in root.panels: DockPanel {
                            visible: p.id == root.bottom-panel; width: parent.width; height: parent.height;
                            panel: p;
                            files: root.files;
                            problems: root.problems;
                            problem-clicked(i) => { root.problem-clicked(i); }
                            references: root.references;
                            reference-clicked(i) => { root.reference-clicked(i); }
                            outline: root.outline;
                            outline-clicked(i) => { root.outline-clicked(i); }
                            ext-rows: root.ext-rows;
                            ext-status: root.ext-status;
                            ext-refresh() => { root.ext-refresh(); }
                            ext-search(q, k) => { root.ext-search(q, k); }
                            ext-install(id) => { root.ext-install(id); }
                            theme-picked(i) => { root.theme-picked(i); }
                            search-rows: root.search-rows;
                            search-status: root.search-status;
                            search-query <=> root.search-query;
                            search-case <=> root.search-case;
                            search-focus: root.search-focus;
                            search-edited => { root.search-edited(); }
                            search-accepted => { root.search-accepted(); }
                            search-clicked(i) => { root.search-clicked(i); }
                            open-tab(id) => { root.open-panel-tab(id); }
                            row-clicked(i) => { root.file-clicked(i); }
                            hide => { root.toggle-panel(p.id); }
                        }
                    }
                }

                if !root.zoomed && root.right-panel != "": HorizontalLayout {
                    Rectangle {
                        width: 1px;
                        background: Theme.border;
                        TouchArea {
                            x: -2px; width: 5px;
                            mouse-cursor: ew-resize;
                            moved => { root.right-w = max(180px, min(640px, root.right-w - (self.mouse-x - self.pressed-x))); }
                        }
                    }
                    Rectangle {
                        width: root.right-w;
                        for p in root.panels: DockPanel {
                            visible: p.id == root.right-panel; width: parent.width; height: parent.height;
                            panel: p;
                            files: root.files;
                            problems: root.problems;
                            problem-clicked(i) => { root.problem-clicked(i); }
                            references: root.references;
                            reference-clicked(i) => { root.reference-clicked(i); }
                            outline: root.outline;
                            outline-clicked(i) => { root.outline-clicked(i); }
                            ext-rows: root.ext-rows;
                            ext-status: root.ext-status;
                            ext-refresh() => { root.ext-refresh(); }
                            ext-search(q, k) => { root.ext-search(q, k); }
                            ext-install(id) => { root.ext-install(id); }
                            theme-picked(i) => { root.theme-picked(i); }
                            search-rows: root.search-rows;
                            search-status: root.search-status;
                            search-query <=> root.search-query;
                            search-case <=> root.search-case;
                            search-focus: root.search-focus;
                            search-edited => { root.search-edited(); }
                            search-accepted => { root.search-accepted(); }
                            search-clicked(i) => { root.search-clicked(i); }
                            open-tab(id) => { root.open-panel-tab(id); }
                            row-clicked(i) => { root.file-clicked(i); }
                            hide => { root.toggle-panel(p.id); }
                        }
                    }
                }
            }

            // ---- status bar -----------------------------------------------
            Rectangle {
                height: 28px;
                background: Theme.chrome;
                Rectangle { y: 0px; height: 1px; background: Theme.border; }
                HorizontalLayout {
                    padding-left: 6px;
                    padding-right: 6px;
                    spacing: 2px;
                    for p in root.left-panels: FlatButton {
                        icon: p.icon; width: 26px; y: 2px;
                        selected: root.left-panel == p.id;
                        clicked => { root.toggle-panel(p.id); }
                    }
                    VSep { height: 14px; y: 7px; }
                    FlatButton { icon: "search"; width: 26px; y: 2px; clicked => { root.open-search(); } }
                    if root.lsp-state >= 0: Rectangle {
                        width: 12px;
                        Rectangle {
                            width: 8px; height: 8px; border-radius: 4px; x: 4px; y: 10px;
                            background: root.lsp-state == 1 ? Theme.success : root.lsp-state == 2 ? Theme.warning
                                : root.lsp-state == 3 || root.lsp-state == 5 ? Theme.danger : Theme.muted-fg;
                        }
                    }
                    FlatButton { label: "Language Servers"; y: 2px; clicked => { lsp-menu.show(); } }
                    FlatButton {
                        icon: "error"; label: "" + root.errors; y: 2px;
                        tint: root.errors > 0 ? Theme.danger : Theme.muted-fg;
                        clicked => { root.toggle-panel("problems"); }
                    }
                    FlatButton {
                        icon: "warn"; label: "" + root.warnings; y: 2px;
                        tint: root.warnings > 0 ? Theme.warning : Theme.muted-fg;
                        clicked => { root.toggle-panel("problems"); }
                    }
                    if root.active-file != "": Text {
                        text: root.active-file; font-size: 12px; color: Theme.muted-fg; vertical-alignment: center;
                    }
                    if root.activity != "": Text {
                        text: root.activity; font-size: 12px; color: Theme.muted-fg; vertical-alignment: center; overflow: elide;
                    }
                    Rectangle { horizontal-stretch: 1; }
                    if root.cursor-text != "": Text {
                        text: root.cursor-text; font-size: 12px; color: Theme.muted-fg; vertical-alignment: center;
                    }
                    if root.language != "": Text {
                        text: "  " + root.language + "  "; font-size: 12px; color: Theme.muted-fg; vertical-alignment: center;
                    }
                    VSep { height: 14px; y: 7px; }
                    for p in root.bottom-panels: FlatButton {
                        icon: p.icon; width: 26px; y: 2px;
                        selected: root.bottom-panel == p.id;
                        clicked => { root.toggle-panel(p.id); }
                    }
                    VSep { height: 14px; y: 7px; }
                    for p in root.right-panels: FlatButton {
                        icon: p.icon; width: 26px; y: 2px;
                        selected: root.right-panel == p.id;
                        clicked => { root.toggle-panel(p.id); }
                    }
                    VSep { height: 14px; y: 7px; }
                    Rectangle {
                        width: 28px;
                        FlatButton {
                            icon: "bell"; width: 26px; y: 2px;
                            clicked => { notice-menu.show(); }
                        }
                        if root.unread-count > 0: Rectangle {
                            x: 16px; y: 3px; width: 8px; height: 8px; border-radius: 4px;
                            background: Theme.primary;
                        }
                    }
                }
            }
        }
    }

    // ---- popups -------------------------------------------------------------

    app-menu := PopupWindow {
        x: 8px; y: 36px; width: 240px;
        PopupSurface {
            VerticalLayout {
                padding: 4px;
                MenuRow { label: "Toggle Left Dock"; hint: "Ctrl+B"; activated => { root.toggle-dock(0); } }
                MenuRow { label: "Toggle Bottom Dock"; hint: "Ctrl+J"; activated => { root.toggle-dock(2); } }
                MenuRow { label: "Toggle Right Dock"; hint: "Ctrl+Alt+B"; activated => { root.toggle-dock(1); } }
                MenuRow { label: "Zoom Tab Area"; hint: "Shift+Esc"; checked: root.zoomed; activated => { root.zoomed = !root.zoomed; } }
                HSep { }
                MenuRow { label: "Split Right"; hint: "Ctrl+\\"; activated => { root.split-active-tab(); } }
                MenuRow { label: "Swap Panes"; hint: "Ctrl+]"; activated => { root.swap-panes(); } }
                MenuRow { label: "Close Tab"; hint: "Ctrl+W"; activated => { root.close-active-tab(); } }
                HSep { }
                MenuRow { label: "Search in Project"; hint: "Ctrl+Shift+F"; activated => { root.open-search(); } }
                MenuRow { label: "Format on Save"; checked: root.format-on-save; activated => { root.toggle-format-on-save(); } }
                MenuRow { label: Theme.dark ? "Light Theme" : "Dark Theme"; activated => { root.toggle-theme(); } }
                HSep { }
                MenuRow { label: "Quit"; activated => { root.quit(); } }
            }
        }
    }

    projects := PopupWindow {
        x: 44px; y: 36px; width: 420px; height: 300px;
        PopupSurface {
            VerticalLayout {
                padding: 6px;
                spacing: 6px;
                LineEdit {
                    init => { self.focus(); }
                    placeholder-text: "Search recent projects…";
                    edited(text) => { root.filter-projects(text); }
                }
                ListView {
                    for path in root.recent: MenuRow {
                        icon: "folder";
                        label: path;
                        activated => { root.pick-project(path); projects.close(); }
                    }
                }
            }
        }
    }

    branch-menu := PopupWindow {
        x: 200px; y: 36px; width: 240px;
        PopupSurface {
            VerticalLayout {
                padding: 4px;
                for b in root.branches: MenuRow {
                    label: b;
                    checked: b == root.branch;
                    activated => { root.pick-branch(b); branch-menu.close(); }
                }
            }
        }
    }

    lsp-menu := PopupWindow {
        x: 260px;
        y: root.height - 28px - 4px - root.lsp-base-h - (root.lsp-open >= 0 ? 84px : 0px);
        width: 340px;
        PopupSurface {
            VerticalLayout {
                padding: 4px;
                if root.servers.length == 0: Text {
                    text: "No language servers yet. Open a file to start one.";
                    font-size: 12px; color: Theme.muted-fg; wrap: word-wrap;
                    height: 36px; vertical-alignment: center; horizontal-alignment: center;
                }
                for s in root.servers: VerticalLayout {
                    if s.header: Text {
                        height: 22px; text: s.name; font-size: 11px; font-weight: 700;
                        color: Theme.muted-fg; vertical-alignment: center; overflow: elide;
                    }
                    if !s.header: Rectangle {
                        height: 28px;
                        border-radius: 4px;
                        background: row-ta.has-hover || root.lsp-open == s.id ? Theme.accent : transparent;
                        row-ta := TouchArea {
                            clicked => { root.lsp-open = root.lsp-open == s.id ? -1 : s.id; }
                        }
                        HorizontalLayout {
                            padding-left: 8px; padding-right: 8px; spacing: 8px;
                            Rectangle {
                                width: 8px;
                                Rectangle {
                                    width: 8px; height: 8px; border-radius: 4px; y: (parent.height - 8px) / 2;
                                    background: s.state == 1 ? Theme.success : s.state == 2 ? Theme.warning
                                        : s.state == 3 || s.state == 5 ? Theme.danger : Theme.muted-fg;
                                }
                            }
                            Text { text: s.name; font-size: 12px; color: Theme.foreground; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                            Text {
                                text: s.state == 0 ? "Starting…" : s.state == 1 ? "Running" : s.state == 2 ? "Warning"
                                    : s.state == 3 ? "Error" : s.state == 4 ? "Stopped" : "Not installed";
                                font-size: 11px; color: Theme.muted-fg; vertical-alignment: center;
                            }
                            Ico { name: root.lsp-open == s.id ? "chevron-down" : "chevron-right"; tint: Theme.muted-fg; size: 12px; y: 8px; }
                        }
                    }
                    if !s.header && root.lsp-open == s.id: Rectangle {
                        height: 84px;
                        VerticalLayout {
                            padding-left: 26px; padding-right: 8px; padding-top: 2px; padding-bottom: 4px; spacing: 4px;
                            Text {
                                text: s.version != "" ? s.version : s.name;
                                font-size: 11px; color: Theme.muted-fg; overflow: elide; height: 16px;
                            }
                            Text {
                                text: s.message;
                                font-size: 11px; color: s.state == 2 ? Theme.warning : s.state == 3 || s.state == 5 ? Theme.danger : Theme.muted-fg;
                                wrap: word-wrap; overflow: elide; vertical-stretch: 1;
                            }
                            HorizontalLayout {
                                spacing: 4px; height: 24px; alignment: start;
                                FlatButton { label: "View Logs"; clicked => { root.lsp-action(s.id, "logs"); lsp-menu.close(); } }
                                FlatButton { label: s.state == 4 ? "Start" : "Restart"; clicked => { root.lsp-action(s.id, "restart"); } }
                                if s.state != 4 && s.state != 5: FlatButton { label: "Stop"; clicked => { root.lsp-action(s.id, "stop"); } }
                            }
                        }
                    }
                }
                if root.servers.length > 0: HSep { }
                if root.servers.length > 0: HorizontalLayout {
                    height: 28px; padding: 2px; spacing: 4px; alignment: start;
                    FlatButton { label: "Restart All Servers"; y: 2px; clicked => { root.lsp-action(0, "restart-all"); } }
                    FlatButton { label: "Stop All Servers"; y: 2px; clicked => { root.lsp-action(0, "stop-all"); } }
                }
            }
        }
    }

    notice-menu := PopupWindow {
        x: root.width - 360px; y: root.height - 28px - 380px; width: 350px; height: 372px;
        PopupSurface {
            VerticalLayout {
                Rectangle {
                    height: 34px;
                    HorizontalLayout {
                        padding-left: 12px; padding-right: 6px; spacing: 4px;
                        Text { text: "Notifications"; font-size: 12px; font-weight: 700; color: Theme.foreground; vertical-alignment: center; horizontal-stretch: 1; }
                        FlatButton { label: "Mark read"; y: 5px; clicked => { root.mark-notices-read(); } }
                        FlatButton { label: "Clear"; y: 5px; clicked => { root.clear-notices(); } }
                    }
                    Rectangle { y: parent.height - 1px; height: 1px; background: Theme.border; }
                }
                if root.notices.length == 0: Text {
                    text: "No notifications";
                    color: Theme.muted-fg; font-size: 12px; horizontal-alignment: center; vertical-alignment: center;
                    vertical-stretch: 1;
                }
                ListView {
                    for n in root.notices: Rectangle {
                        height: 62px;
                        background: n.read ? transparent : Theme.hover;
                        HorizontalLayout {
                            padding: 10px; spacing: 10px;
                            Ico {
                                name: n.kind == 3 ? "error" : n.kind == 2 ? "warn" : n.kind == 1 ? "check" : "info";
                                tint: n.kind == 3 ? Theme.danger : n.kind == 2 ? Theme.warning : n.kind == 1 ? Theme.success : Theme.info;
                                size: 16px;
                            }
                            VerticalLayout {
                                spacing: 2px;
                                horizontal-stretch: 1;
                                HorizontalLayout {
                                    Text { text: n.title; font-size: 12px; font-weight: 600; color: Theme.foreground; horizontal-stretch: 1; overflow: elide; }
                                    Text { text: n.time; font-size: 11px; color: Theme.muted-fg; }
                                }
                                Text { text: n.message; font-size: 11px; color: Theme.muted-fg; wrap: word-wrap; overflow: elide; }
                            }
                        }
                    }
                }
            }
        }
    }

    // Resize grips: the frameless window has no native borders.
    TouchArea {
        x: parent.width - 5px; y: 36px; width: 5px; height: parent.height - 41px;
        mouse-cursor: ew-resize;
        moved => { root.resize-window(self.mouse-x - self.pressed-x, 0px); }
    }
    TouchArea {
        x: 0px; y: parent.height - 5px; width: parent.width - 10px; height: 5px;
        mouse-cursor: ns-resize;
        moved => { root.resize-window(0px, self.mouse-y - self.pressed-y); }
    }
    TouchArea {
        x: parent.width - 10px; y: parent.height - 10px; width: 10px; height: 10px;
        mouse-cursor: nwse-resize;
        moved => { root.resize-window(self.mouse-x - self.pressed-x, self.mouse-y - self.pressed-y); }
    }

    init => { fs.focus(); }
}
