import { Theme, Icons } from "theme.slint";

export component Ico inherits Image {
    in property <string> name;
    in property <length> size: 14px;
    in property <color> tint: Theme.foreground;
    width: size;
    height: size;
    source: Icons.by-name(name);
    colorize: tint;
}

// A small flat button: icon and/or label, highlighted when `selected`.
export component FlatButton inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <bool> selected;
    in property <color> tint: selected ? Theme.foreground : Theme.muted-fg;
    in property <length> pad: 6px;
    callback clicked();
    callback right-clicked();
    callback pressed-at(length, length);
    out property <bool> hovered: ta.has-hover;
    height: 24px;
    border-radius: 4px;
    background: selected ? Theme.accent : ta.has-hover ? Theme.hover : transparent;

    ta := TouchArea {
        pointer-event(e) => {
            if e.kind == PointerEventKind.down && e.button == PointerEventButton.right {
                root.right-clicked();
                root.pressed-at(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
        }
        clicked => { root.clicked(); }
    }
    HorizontalLayout {
        padding-left: root.pad;
        padding-right: root.pad;
        spacing: 5px;
        alignment: center;
        if root.icon != "": Ico { name: root.icon; tint: root.tint; y: (parent.height - self.height) / 2; }
        if root.label != "": Text {
            text: root.label;
            color: root.tint;
            font-size: 12px;
            vertical-alignment: center;
        }
    }
}

export component VSep inherits Rectangle {
    width: 1px;
    background: Theme.border;
}

export component HSep inherits Rectangle {
    height: 1px;
    background: Theme.border;
}

// A row in a popup menu.
export component MenuRow inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <string> hint;
    in property <bool> checked;
    in property <bool> enabled: true;
    callback activated();
    height: 26px;
    border-radius: 4px;
    background: ta.has-hover && enabled ? Theme.accent : transparent;
    ta := TouchArea {
        enabled: root.enabled;
        clicked => { root.activated(); }
    }
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 8px;
        Rectangle {
            width: 14px;
            if root.icon != "": Ico { name: root.icon; tint: Theme.muted-fg; y: (parent.height - self.height) / 2; }
            if root.icon == "" && root.checked: Ico { name: "check"; tint: Theme.primary; y: (parent.height - self.height) / 2; }
        }
        Text {
            text: root.label;
            color: root.enabled ? Theme.foreground : Theme.muted-fg;
            font-size: 12px;
            vertical-alignment: center;
            overflow: elide;
        }
        Text {
            text: root.hint;
            color: Theme.muted-fg;
            font-size: 11px;
            vertical-alignment: center;
            horizontal-alignment: right;
        }
    }
}

// Popup surface with the shell's border and shadow.
export component PopupSurface inherits Rectangle {
    background: Theme.popover;
    border-radius: 6px;
    border-width: 1px;
    border-color: Theme.border;
    drop-shadow-blur: 14px;
    drop-shadow-color: #00000066;
    drop-shadow-offset-y: 4px;
}

// Minimise / maximise / close button of the custom title bar.
export component WinButton inherits Rectangle {
    in property <string> kind; // "min", "max" or "close"
    callback clicked();
    width: 46px;
    background: ta.has-hover ? (kind == "close" ? #e81123 : Theme.hover) : transparent;
    ta := TouchArea { clicked => { root.clicked(); } }
    if root.kind == "min": Rectangle {
        width: 10px; height: 1px; background: ta.has-hover && root.kind == "close" ? white : Theme.foreground;
    }
    if root.kind == "max": Rectangle {
        width: 10px; height: 10px; border-width: 1px; border-color: Theme.foreground;
    }
    if root.kind == "close": Ico {
        name: "close"; size: 14px; tint: ta.has-hover ? white : Theme.foreground;
    }
}
